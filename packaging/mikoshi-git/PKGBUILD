# Maintainer: NullWRX <your-email@example.com>
#
# Builds Mikoshi from the latest commit on GitHub. Use this to test before a release:
#   git clone https://github.com/NullWRX/Mikoshi && cd mikoshi/packaging/mikoshi-git && makepkg -si

pkgbase=mikoshi-git
pkgname=(mikoshi-git mikoshi-gui-git)
pkgver=0.1.0
pkgrel=1
pkgdesc="Snapshot backups for Arch Linux, built on rsync"
arch=('any')
url="https://github.com/NullWRX/Mikoshi"
license=('GPL-3.0-or-later')
makedepends=('git' 'python')
checkdepends=('python-pytest' 'rsync')
source=("mikoshi::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd mikoshi
  local base
  base=$(sed -n 's/^__version__ = "\(.*\)"/\1/p' src/mikoshi/__init__.py)
  printf "%s.r%s.g%s" "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

check() {
  cd mikoshi
  PYTHONPATH=src python -m pytest -q tests
}

package_mikoshi-git() {
  pkgdesc="Snapshot backups for Arch Linux, built on rsync (command line, timers, pacman hook)"
  depends=('python>=3.12' 'rsync' 'util-linux' 'systemd')
  optdepends=('mikoshi-gui-git: the graphical app'
              'nfs-utils: back up to NFS shares'
              'cryptsetup: encrypted backup drives and LUKS header backups'
              'btrfs-progs: record btrfs subvolume layout'
              'lvm2: record LVM layout'
              'efibootmgr: record UEFI boot entries'
              'libnotify: desktop notifications'
              'dconf: save GNOME settings as text')
  provides=('mikoshi')
  conflicts=('mikoshi' 'lifeboat' 'lifeboat-git')
  replaces=('lifeboat-git')
  install=mikoshi.install
  cd mikoshi
  make DESTDIR="$pkgdir" PREFIX=/usr install-core
}

package_mikoshi-gui-git() {
  pkgdesc="Snapshot backups for Arch Linux, built on rsync (GTK app)"
  depends=('mikoshi-git' 'python-gobject' 'gtk4' 'libadwaita' 'librsvg' 'polkit')
  provides=('mikoshi-gui')
  conflicts=('mikoshi-gui' 'lifeboat-gui' 'lifeboat-gui-git')
  replaces=('lifeboat-gui-git')
  cd mikoshi
  make DESTDIR="$pkgdir" PREFIX=/usr install-gui
}
