# Runs Mikoshi jobs that have "before pacman" turned on, before packages change.
# Does nothing if no job uses it, and never stops the transaction if a backup fails.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Mikoshi pre-transaction backup
When = PreTransaction
Exec = /usr/bin/mikoshi hook pacman
